set -e

# bytecode Python may have written next to the code (a run as root)
if [ -d /usr/share/activitytrack-desktop ]; then
	find /usr/share/activitytrack-desktop -name __pycache__ -type d -prune -exec rm -rf {} +
fi

#DEBHELPER#
