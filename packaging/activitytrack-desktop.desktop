[Desktop Entry]
Type=Application
Name=ActivityTrack
GenericName=Time tracking
GenericName[it]=Registrazione attività
GenericName[de]=Tätigkeitserfassung
GenericName[es]=Registro de actividades
Comment=Running activities and to-dos of ActivityTrack, from the tray
Comment[it]=Attività in corso e Da fare di ActivityTrack, dall'area di notifica
Comment[de]=Laufende Tätigkeiten und Aufgaben von ActivityTrack, aus dem Infobereich
Comment[es]=Actividades en curso y pendientes de ActivityTrack, desde el área de notificación
Exec=activitytrack-desktop
Icon=activitytrack-desktop
Terminal=false
Categories=Office;ProjectManagement;Qt;
Keywords=time;tracking;activities;todo;
Keywords[it]=tempo;attività;da fare;ore;
Keywords[de]=Zeit;Erfassung;Tätigkeiten;Aufgaben;Stunden;
Keywords[es]=tiempo;registro;actividades;pendientes;horas;
StartupNotify=false
SingleMainWindow=true
